DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lnf_db"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Optional local phone testing: set to this computer's private LAN origin, for example http://192.168.1.20:3000.
REVOK_LOCAL_NETWORK_ORIGIN=""
REVOK_SUPER_ADMIN_EMAIL="your-admin-email@example.com"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# MSG91 OTP Widget Configuration
# Private Server AuthKey (e.g. from MSG91 dashboard Settings -> Authkey)
# Keep this private on the backend. Add this to your local .env and to Vercel Environment Variables.
MSG91_AUTH_KEY=""

# MSG91 OTP Widget Public Client Configuration (safe for browser)
NEXT_PUBLIC_MSG91_WIDGET_ID="366b67695879383238353332"
NEXT_PUBLIC_MSG91_TOKEN_AUTH=""

# Legacy MSG91 API configuration (optional fallback)
MSG91_OTP_TEMPLATE_ID=""
MSG91_OTP_LENGTH="4"
MSG91_OTP_EXPIRY_MINUTES="15"
MSG91_ENABLED="true"

# Production uploads require S3-compatible object storage. S3_ENDPOINT is optional for AWS S3.
UPLOAD_STORAGE="filesystem"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
