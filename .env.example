DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lnf_db"
BETTER_AUTH_SECRET="YOUR_BETTER_AUTH_SECRET"
BETTER_AUTH_URL="http://localhost:3000"
# Optional local phone testing: set to this computer's private LAN origin, for example http://192.168.1.20:3000.
REVOK_LOCAL_NETWORK_ORIGIN=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
REVOK_SUPER_ADMIN_EMAIL=""

# MSG91 OTP (SMS remains disabled until complete account configuration is added)
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_OTP_LENGTH="6"
MSG91_OTP_EXPIRY_MINUTES="5"
MSG91_ENABLED="false"

# Production uploads require S3-compatible object storage. S3_ENDPOINT is optional for AWS S3.
UPLOAD_STORAGE="filesystem"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
