generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  REVOK_STEWARD
}

enum UserStatus {
  ACTIVE
  RESTRICTED
  BANNED
  DELETED
}

enum ItemType {
  LOST
  FOUND
}

enum ItemStatus {
  ACTIVE
  MATCHED
  CLAIMED
  RETURNED
  CLOSED
  REMOVED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  RECOVERED
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum NotificationType {
  MATCH
  CLAIM
  MESSAGE
  SYSTEM
  MODERATION
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FRIEND_REPORT
  REPORT_COMMENT
  REPORT_HINT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  REMOVED
}

enum ReportMessageKind {
  COMMENT
  HINT
}

enum MessageType {
  TEXT
  SYSTEM
}

enum ModerationStatus {
  PENDING
  APPROVED
  FLAGGED
  BLOCKED
}

model User {
  id        String  @id @default(cuid())
  name      String
  about     String? @db.VarChar(280)
  email     String  @unique
  emailVerified Boolean @default(false)
  image     String?

  username       String? @unique
  displayUsername String?

  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  phoneVerifiedAt     DateTime?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  lostItems                LostItem[]
  foundItems               FoundItem[]
  claims                   Claim[]
  sentMessages             Message[]
  notifications            Notification[]
  inventoryItems           InventoryItem[]
  auditLogs                AuditLog[] @relation("ActorAuditLogs")
  moderationEvents         ModerationEvent[]
  conversationParticipants ConversationParticipant[]
  handoversAsFinder HandoverRequest[] @relation("HandoverFinder")
  handoversAsSteward HandoverRequest[] @relation("HandoverSteward")
  custodyItems FoundItem[] @relation("FoundItemCustodian")
  submittedUserReports UserReport[] @relation("UserReportReporter")
  receivedUserReports UserReport[] @relation("UserReportReported")
  reviewedUserReports UserReport[] @relation("UserReportReviewer")
  sentFriendships Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipRecipient")
  sentReportMessages ReportMessage[] @relation("ReportMessageSender")
  ownedReportMessages ReportMessage[] @relation("ReportMessageOwner")

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lostItems  LostItem[]
  foundItems FoundItem[]
}

model LostItem {
  id          String     @id @default(cuid())
  userId      String
  categoryId  String
  brand          String?
  color          String?
  subcategory    String?
  model          String?
  material       String?
  identifyingMarks String?
  approximateTime String?
  locationDetails String?
  contactedAbout String?
  privateDetails String?

  title       String
  description String
  location    String
  lostAt      DateTime

  status      ItemStatus       @default(ACTIVE)
  moderation  ModerationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  images       ItemImage[]
  matches      Match[]
  claims       Claim[]
  reportMessages ReportMessage[]
  notifications Notification[]
}

model FoundItem {
  id          String     @id @default(cuid())
  userId      String
  custodianId String?
  categoryId  String
  brand          String?
  color          String?
  subcategory    String?
  model          String?
  material       String?
  identifyingMarks String?
  approximateTime String?
  locationDetails String?
  custodyStatus  String?
  privateDetails String?

  title       String
  description String
  location    String
  foundAt     DateTime

  status      ItemStatus       @default(ACTIVE)
  moderation  ModerationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user     User     @relation(fields: [userId], references: [id])
  custodian User? @relation("FoundItemCustodian", fields: [custodianId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  images       ItemImage[]
  matches      Match[]
  claims       Claim[]
  handovers HandoverRequest[]
  userReports UserReport[]
  notifications Notification[]
  reportMessages ReportMessage[]

  @@index([custodianId])
}

model ItemImage {
  id         String @id @default(cuid())
  url        String
  storageKey String
  mimeType   String
  sizeBytes  Int

  lostItemId  String?
  foundItemId String?

  createdAt DateTime @default(now())

  lostItem  LostItem?  @relation(fields: [lostItemId], references: [id])
  foundItem FoundItem? @relation(fields: [foundItemId], references: [id])
}

model Match {
  id          String      @id @default(cuid())
  lostItemId  String
  foundItemId String

  score       Float
  reason      String?
  status      MatchStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lostItem  LostItem  @relation(fields: [lostItemId], references: [id])
  foundItem FoundItem @relation(fields: [foundItemId], references: [id])

  @@unique([lostItemId, foundItemId])
  @@index([score])
}

model Claim {
  id          String      @id @default(cuid())
  userId      String
  lostItemId  String?
  foundItemId String?

  status      ClaimStatus @default(PENDING)
  message     String?
  conversationId String? @unique
  recoveryCodeHash String?
  recoveryCodeCiphertext String?
  recoveryCodeIv String?
  recoveryCodeTag String?
  recoveryCodeExpiresAt DateTime?
  recoveryCodeAttempts Int @default(0)
  recoveryCodeUsedAt DateTime?
  recoveryCodeIssuedAt DateTime?
  recoveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  lostItem  LostItem?  @relation(fields: [lostItemId], references: [id])
  foundItem FoundItem? @relation(fields: [foundItemId], references: [id])
  conversation ChatConversation? @relation(fields: [conversationId], references: [id])
  userReports UserReport[]
  notifications Notification[]

  @@index([foundItemId, status])
  @@index([userId, status])
}

model ChatConversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  claim Claim?
}

model ConversationParticipant {
  id             String @id @default(cuid())
  conversationId String
  userId         String

  joinedAt DateTime @default(now())
  lastReadAt DateTime?
  deletedAt DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id])
  user         User             @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String

  content String
  type    MessageType @default(TEXT)

  createdAt DateTime @default(now())
  deletedAt DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id])
  sender       User             @relation(fields: [senderId], references: [id])
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType

  title   String
  message String
  readAt  DateTime?
  foundItemId String?
  lostItemId String?
  inventoryItemId String?
  claimId String?
  friendshipId String?
  reportMessageId String? @unique
  dedupeKey String? @unique

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  foundItem FoundItem? @relation(fields: [foundItemId], references: [id], onDelete: SetNull)
  lostItem LostItem? @relation(fields: [lostItemId], references: [id], onDelete: SetNull)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  claim Claim? @relation(fields: [claimId], references: [id], onDelete: SetNull)
  friendship Friendship? @relation(fields: [friendshipId], references: [id], onDelete: SetNull)
  reportMessage ReportMessage? @relation(fields: [reportMessageId], references: [id], onDelete: SetNull)

  @@unique([userId, type, foundItemId, inventoryItemId])
  @@index([userId, readAt, createdAt])
}

model InventoryItem {
  id             String   @id @default(cuid())
  userId         String
  name           String   @db.VarChar(100)
  normalizedName String   @db.VarChar(100)
  brand          String?  @db.VarChar(100)
  color          String?  @db.VarChar(80)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([userId, normalizedName])
  @@index([userId, createdAt])
}

model Friendship {
  id          String           @id @default(cuid())
  pairKey     String           @unique
  requesterId String
  recipientId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  acceptedAt  DateTime?

  requester User           @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User           @relation("FriendshipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([requesterId, status, updatedAt])
  @@index([recipientId, status, updatedAt])
}

model ReportMessage {
  id              String            @id @default(cuid())
  lostItemId      String?
  foundItemId     String?
  reportOwnerId   String
  senderId        String
  parentMessageId String?
  clientRequestId String            @unique
  kind            ReportMessageKind
  body            String            @db.VarChar(2000)
  location        String?           @db.VarChar(180)
  sightingAt      DateTime?
  createdAt       DateTime          @default(now())

  lostItem LostItem? @relation(fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem FoundItem? @relation(fields: [foundItemId], references: [id], onDelete: Cascade)
  reportOwner User @relation("ReportMessageOwner", fields: [reportOwnerId], references: [id], onDelete: Cascade)
  sender User @relation("ReportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  parent ReportMessage? @relation("ReportMessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies ReportMessage[] @relation("ReportMessageReplies")
  notifications Notification[]

  @@index([lostItemId, createdAt])
  @@index([foundItemId, createdAt])
  @@index([reportOwnerId, createdAt])
  @@index([senderId, createdAt])
  @@index([parentMessageId, createdAt])
}

enum HandoverStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

model HandoverRequest {
  id String @id @default(cuid())
  foundItemId String
  finderId String
  stewardId String
  previousCustodyStatus String?
  status HandoverStatus @default(PENDING)
  requestedAt DateTime @default(now())
  respondedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foundItem FoundItem @relation(fields: [foundItemId], references: [id])
  finder User @relation("HandoverFinder", fields: [finderId], references: [id])
  steward User @relation("HandoverSteward", fields: [stewardId], references: [id])

  @@index([stewardId, status])
  @@index([foundItemId, status])
}

model UserReport {
  id String @id @default(cuid())
  reporterId String
  reportedUserId String
  claimId String
  foundItemId String
  reason String
  description String @db.VarChar(3000)
  adminDecision String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())

  reporter User @relation("UserReportReporter", fields: [reporterId], references: [id])
  reportedUser User @relation("UserReportReported", fields: [reportedUserId], references: [id])
  reviewer User? @relation("UserReportReviewer", fields: [reviewedBy], references: [id])
  claim Claim @relation(fields: [claimId], references: [id])
  foundItem FoundItem @relation(fields: [foundItemId], references: [id])

  @@unique([reporterId, claimId])
  @@index([createdAt])
}

model ModerationEvent {
  id     String @id @default(cuid())
  userId String?

  entityType String
  entityId   String

  status   ModerationStatus
  score    Float?
  reason   String?

  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entityType String
  entityId  String?
  details   Json?

  createdAt DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id])
}

model UserDeletionRecord {
  id             String   @id @default(cuid())
  originalUserId String
  name           String
  username       String?
  reason         String
  deletedBy      String
  deletedAt      DateTime @default(now())

  @@index([originalUserId])
  @@index([deletedBy])
}
